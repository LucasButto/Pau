# Copiá este archivo como `.env.local` y ajustá los valores.

# Estilo base del mapa (MapLibre, esquema OpenMapTiles). Sobre este estilo se aplica la
# recoloración PAU, clara (src/map/pauStyle.ts). Si se deja vacío se usa OpenFreeMap "positron",
# cuya copia revisada vive en src/map/base-style.json.
# Otras opciones de OpenFreeMap: liberty, bright, dark, fiord.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# URL pública del sitio (SEO: canonical, og:image, sitemap, robots). Si se deja vacía se usa el dominio
# de producción de Vercel (VERCEL_PROJECT_PRODUCTION_URL) o, en su defecto, https://pau-red.vercel.app.
# Completala solo si publicás en un dominio propio, por ejemplo https://www.midominio.com.ar
VITE_SITE_URL=

# Endpoint del newsletter: recibe POST con JSON { "email": "..." } y responde 2xx si salió bien.
# TODO: completar antes de publicar. Sin este valor, en producción el formulario muestra error.
VITE_NEWSLETTER_ENDPOINT=
